<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Library</OutputType>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <Configurations>Debug;Release;SignedRelease</Configurations>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <IncludeSource>true</IncludeSource>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)' == 'SignedRelease|AnyCPU'">
    <OutputPath>bin\SignedRelease\</OutputPath>
    <Optimize>true</Optimize>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="publish\**" />
    <EmbeddedResource Remove="publish\**" />
    <None Remove="publish\**" />
    <Page Remove="publish\**" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\CommonAssemblyInfo.cs">
      <Link>Properties\CommonAssemblyInfo.cs</Link>
    </Compile>
  </ItemGroup>
  <ItemGroup>
    <None Include="..\LICENSE.txt">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\OpenAstroAra.Core\OpenAstroAra.Core.csproj" />
    <ProjectReference Include="..\OpenAstroAra.Profile\OpenAstroAra.Profile.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Fastenshtein" />
    <PackageReference Include="Nito.AsyncEx.Context" />
    <PackageReference Include="Nito.Disposables" />
  </ItemGroup>
  <PropertyGroup>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <Title>$(AssemblyName)</Title>
    <Version>3.2.0.9001</Version>
    <Company>$(Authors)</Company>
    <Product>OpenAstro Ara</Product>
    <Description>Astronomy components of OpenAstro Ara (forked from N.I.N.A.).</Description>
    <Copyright>Copyright ©  2016 - 2025 Stefan Berg and the N.I.N.A. contributors</Copyright>
    <PackageProjectUrl>https://github.com/open-astro/openastro-ara</PackageProjectUrl>
    <RepositoryUrl>https://github.com/open-astro/openastro-ara.git</RepositoryUrl>
    <PackageOutputPath>$(SolutionDir)publish</PackageOutputPath>
    <Authors>Stefan Berg and the N.I.N.A. Contributors</Authors>
    <PackageLicenseFile>LICENSE.txt</PackageLicenseFile>
  </PropertyGroup>
  <ItemGroup>
    <!-- §14e — the JPL DE421 planetary ephemeris (1900-2053) SuperNOVAS' legacy eph_manager
         reads. NINA's Windows installer shipped this file; the port has to carry
         it itself or every NOVAS body position is confidently wrong on a host
         without it (found on rc91: sun at -73° in mid-morning). Copied next to
         the binaries so NOVAS.EphemerisLocation (BaseDirectory/External/JPLEPH)
         resolves in dev, publish and the deb alike. -->
    <Content Include="External\JPLEPH">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>External\JPLEPH</Link>
    </Content>
    <!-- #1190 - the IERS Bulletin A UT1-UTC snapshot Dut1Table reads (regenerate with
         scripts/update-dut1-table.py before a release). Embedded rather than copied so the
         daemon has it wherever the assembly runs, offline included. -->
    <EmbeddedResource Include="External\iers-dut1.tsv" LogicalName="OpenAstroAra.Astrometry.External.iers-dut1.tsv" />
  </ItemGroup>
  <!-- §14e — the ERFA + SuperNOVAS natives on Linux/macOS, built once from the third_party/
       submodules by scripts/build-astrometry-natives.sh into obj/ and copied to every consumer's output
       (Server, Test) the way External\JPLEPH is. Before this, a fresh checkout or worktree ran
       `dotnet test` with 34 astrometry, refraction and sequencer-target failures until someone
       ran the script by hand into the test bin dir (2026-10-17). Incremental: rebuilt only when a
       submodule source or the script changes. They are build-output only, never publish output
       (CopyToPublishDirectory=Never): a cross-publish (linux-arm64 from an x64 runner or a Mac)
       must not carry host-arch libraries, and CI stages its own arm64 build after publish. The
       RuntimeIdentifier guard alone does not achieve that — this is a RID-agnostic library, so the
       SDK undefines RuntimeIdentifier for it inside a Server publish and the target runs anyway
       (review of #1388; repro: `dotnet publish OpenAstroAra.Server -r linux-arm64` carried
       host-built natives). A host without a C compiler gets a warning and the
       un-staged behaviour it had before (the transform tests self-Ignore); Directory.Build.props'
       TreatWarningsAsErrors is the C# compiler's, not MSBuild's, so the build still succeeds.
       The output dir is computed inside the targets: IntermediateOutputPath is not defined until
       the SDK targets import, after the project body. -->
  <Target Name="_AstrometryNativeProps">
    <PropertyGroup>
      <!-- NormalizeDirectory: IntermediateOutputPath is relative today, but an absolute
           BaseIntermediateOutputPath or UseArtifactsOutput would otherwise double the prefix. -->
      <AstrometryNativesDir>$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)', '$(IntermediateOutputPath)', 'natives'))</AstrometryNativesDir>
      <AstrometryNativeExt Condition="$([MSBuild]::IsOSPlatform('OSX'))">dylib</AstrometryNativeExt>
      <AstrometryNativeExt Condition="'$(AstrometryNativeExt)' == ''">so</AstrometryNativeExt>
      <_AstrometryErfa>$(AstrometryNativesDir)liberfa.$(AstrometryNativeExt)</_AstrometryErfa>
      <_AstrometryNovas>$(AstrometryNativesDir)libsupernovas.$(AstrometryNativeExt)</_AstrometryNovas>
      <_AstrometrySubmodules>$(MSBuildProjectDirectory)/../third_party</_AstrometrySubmodules>
    </PropertyGroup>
    <ItemGroup>
      <_AstrometryNativeSource Include="$(MSBuildProjectDirectory)/../scripts/build-astrometry-natives.sh;$(_AstrometrySubmodules)/erfa/src/*.c;$(_AstrometrySubmodules)/erfa/src/*.h;$(_AstrometrySubmodules)/erfa/configure.ac;$(_AstrometrySubmodules)/supernovas/src/c99/*.c;$(_AstrometrySubmodules)/supernovas/include/*.h;$(_AstrometrySubmodules)/supernovas/include/**/*.c;$(_AstrometrySubmodules)/supernovas/legacy/*.c;$(_AstrometrySubmodules)/supernovas/legacy/*.h" />
    </ItemGroup>
  </Target>
  <Target Name="_CompileAstrometryNatives"
          DependsOnTargets="_AstrometryNativeProps"
          Inputs="@(_AstrometryNativeSource)"
          Outputs="$(_AstrometryErfa);$(_AstrometryNovas)">
    <!-- An un-initialised submodule is a checkout error, not a missing compiler: say so and
         stop, rather than warn and build a daemon without transforms. -->
    <Error Condition="!Exists('$(_AstrometrySubmodules)/erfa/src/erfa.h') or !Exists('$(_AstrometrySubmodules)/supernovas/include/novas.h')"
           Text="third_party/erfa or third_party/supernovas is empty — the astrometry sources are git submodules. Run: git submodule update --init" />
    <!-- Drop the previous pair first: a rebuild that fails (a source edit that does not
         compile) must leave nothing for the Exists checks to stage, so the warning fires
         instead of a stale library shipping quietly. -->
    <Delete Files="$(_AstrometryErfa);$(_AstrometryNovas)" />
    <Exec Command="bash scripts/build-astrometry-natives.sh &quot;$(AstrometryNativesDir)&quot;"
          WorkingDirectory="$(MSBuildProjectDirectory)/.."
          ContinueOnError="true"
          StandardOutputImportance="low" />
  </Target>
  <Target Name="BuildAstrometryNatives"
          BeforeTargets="AssignTargetPaths"
          DependsOnTargets="_AstrometryNativeProps;_CompileAstrometryNatives"
          Condition="'$(OS)' != 'Windows_NT' and '$(RuntimeIdentifier)' == ''">
    <ItemGroup>
      <!-- Literal Link values: a %(Filename) transform here batches against the JPLEPH
           Content item above and copied the library out as "JPLEPH". -->
      <Content Include="$(_AstrometryErfa)" Condition="Exists('$(_AstrometryErfa)') and Exists('$(_AstrometryNovas)')">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        <Link>liberfa.$(AstrometryNativeExt)</Link>
        <CopyToPublishDirectory>Never</CopyToPublishDirectory>
        <Visible>false</Visible>
      </Content>
      <Content Include="$(_AstrometryNovas)" Condition="Exists('$(_AstrometryErfa)') and Exists('$(_AstrometryNovas)')">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        <Link>libsupernovas.$(AstrometryNativeExt)</Link>
        <CopyToPublishDirectory>Never</CopyToPublishDirectory>
        <Visible>false</Visible>
      </Content>
    </ItemGroup>
    <Warning Condition="!Exists('$(_AstrometryErfa)') or !Exists('$(_AstrometryNovas)')"
             Text="ERFA/SuperNOVAS astrometry natives were not built (no C compiler?) — cross-epoch transforms and the tests that need them will not work on this host. See scripts/build-astrometry-natives.sh." />
  </Target>
</Project>