# bench/Dockerfile.linux-arm64 — the §42.2 virtual-observatory bench's standing
# Linux/arm64 lane (bench-5). Builds and runs the hardware-free bench suite —
# AlpacaFaultProxy, FakeGuider, and the real-client guider fault scenarios — on a
# real Linux kernel + .NET runtime, the platform the §13 RPi deployment targets.
#
# Why a hermetic copy-in image instead of a bind-mount: the host builds for
# osx-arm64 and this lane for linux-arm64; sharing the source tree's obj/bin
# across the two RIDs corrupts each other's restore state. Copying the source in
# keeps the Linux build fully isolated from the host's — run it as often as you
# like without disturbing a local `dotnet test` on the Mac. The repo-root
# .dockerignore keeps host bin/obj out of the build context on BOTH the classic
# builder and BuildKit (a per-Dockerfile .dockerignore would be honored only by
# BuildKit, missing the classic-builder path run.sh can fall back to).
#
# The bench tests are self-contained (in-process StubAlpaca + FakeGuider, no
# OmniSim, no hardware), so this image needs nothing but the SDK and the .NET 10
# runtime the net10.0 tests run on.
#
# Build + run via bench/docker-compose.yml (see bench/README.md), or directly:
#   docker build -f bench/Dockerfile.linux-arm64 --platform linux/arm64 -t ara-bench .
#   docker run --rm --platform linux/arm64 ara-bench
#
# The SDK image follows global.json (11.0, latestFeature never falls back to an
# older major). The tests target net10.0, so the .NET 10 shared runtimes are copied
# in from the aspnet:10.0 image. Both tags are intentionally floating, not pinned
# digests: this lane exists to catch a runtime/kernel regression in the Drop-fault
# mechanic, so it should track the latest .NET 10 runtime patch and surface a break
# when one lands — pinning would freeze the very thing under test. To reproduce a
# specific failure deterministically, pin the digests reported by `docker inspect`.
FROM --platform=linux/arm64 mcr.microsoft.com/dotnet/aspnet:10.0 AS runtime10
FROM --platform=linux/arm64 mcr.microsoft.com/dotnet/sdk:11.0
COPY --from=runtime10 /usr/share/dotnet/shared /usr/share/dotnet/shared

WORKDIR /src
COPY . .

# Restore + build the bench test project graph once at image-build time so the
# container's run command (the test pass) doesn't rebuild on every invocation.
# Release mirrors the host gate: the analyzer globalization rules that trip a
# Debug build are off in Release, so this stays warnings-clean.
RUN dotnet build OpenAstroAra.Test/OpenAstroAra.Test.csproj -c Release

# The bench suite is selected by the NUnit [Category("bench")] tag on its three
# fixtures — one source of truth, so a new bench fixture is picked up just by
# tagging it (no filter to keep in sync here or in README).
ENTRYPOINT ["dotnet", "test", "OpenAstroAra.Test/OpenAstroAra.Test.csproj", \
            "-c", "Release", "--no-build", "--filter", "TestCategory=bench"]
