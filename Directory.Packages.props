<Project>

  <!--
    Central Package Management (#1174). Every NuGet version in the repo lives here;
    the project files carry bare <PackageReference Include="..."/> lines. One place to
    bump, no two projects drifting apart on the same package (CPM refuses a version
    attribute in a project with NU1008, so drift cannot creep back in).

    The ranges are deliberate: SharpGIS.NmeaParser and Microsoft.OpenApi are pinned to
    the exact version their call sites were verified against; FluentAssertions stays
    on the last Apache-licensed line.

    xunit 2.9.3 is NuGet-deprecated as "legacy" (superseded by xunit.v3), not vulnerable.
    xunit.v3 runs only on Microsoft.Testing.Platform, which the .NET 10 SDK's `dotnet test`
    refuses to drive in VSTest mode — and the repo runs every test project (NUnit included)
    through one VSTest-mode `dotnet test OpenAstroAra.sln`. Moving the three small xunit
    projects means moving the whole solution to the new runner (global.json "test.runner"),
    which is its own change; until then the deprecation stays known and accepted (#1174).
  -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>false</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup>
    <PackageVersion Include="ASCOM.Alpaca.Components" Version="4.1.0" />
    <PackageVersion Include="ASCOM.Alpaca.Device" Version="4.1.0" />
    <PackageVersion Include="ASCOM.Tools" Version="4.1.0" />
    <PackageVersion Include="Castle.Core" Version="5.2.1" />
    <PackageVersion Include="Castle.Core.AsyncInterceptor" Version="2.1.0" />
    <PackageVersion Include="CommandLineParser" Version="2.9.1" />
    <PackageVersion Include="Fastenshtein" Version="1.0.12" />
    <PackageVersion Include="FluentAssertions" Version="[7.2.2]" />
    <PackageVersion Include="Iconic.Zlib.Netstandard" Version="1.0.0" />
    <PackageVersion Include="K4os.Compression.LZ4" Version="1.3.8" />
    <PackageVersion Include="Makaretu.Dns.Multicast" Version="0.27.0" />
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Data.Sqlite" Version="10.0.13" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.13" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageVersion Include="Microsoft.OpenApi" Version="[2.13.0]" />
    <PackageVersion Include="Moq" Version="4.21.0" />
    <PackageVersion Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageVersion Include="Nito.AsyncEx" Version="5.1.2" />
    <PackageVersion Include="Nito.AsyncEx.Context" Version="5.1.2" />
    <PackageVersion Include="Nito.Disposables" Version="2.5.0" />
    <PackageVersion Include="NJsonSchema" Version="11.6.1" />
    <PackageVersion Include="NUnit" Version="5.0.0" />
    <PackageVersion Include="NUnit.Analyzers" Version="4.15.0" />
    <PackageVersion Include="NUnit3TestAdapter" Version="6.3.1" />
    <PackageVersion Include="Scalar.AspNetCore" Version="2.18.2" />
    <PackageVersion Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageVersion Include="Serilog.Formatting.Compact" Version="3.0.0" />
    <PackageVersion Include="Serilog.Sinks.Console" Version="6.1.1" />
    <PackageVersion Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageVersion Include="SharpGIS.NmeaParser" Version="[2.2.2]" />
    <PackageVersion Include="SkiaSharp" Version="4.153.1" />
    <PackageVersion Include="SkiaSharp.NativeAssets.Linux" Version="4.153.1" />
    <PackageVersion Include="SQLitePCLRaw.lib.e_sqlite3" Version="3.53.3" />
    <PackageVersion Include="System.ComponentModel.Annotations" Version="5.0.0" />
    <PackageVersion Include="System.Configuration.ConfigurationManager" Version="10.0.13" />
    <PackageVersion Include="System.Drawing.Common" Version="10.0.13" />
    <PackageVersion Include="System.IO.Ports" Version="10.0.13" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="Zeroconf" Version="3.7.16" />
    <PackageVersion Include="ZstdSharp.Port" Version="0.8.8" />
  </ItemGroup>

</Project>
