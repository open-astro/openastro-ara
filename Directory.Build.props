<Project>

  <!--
    Repo-wide Roslyn analyzer escalation (2026-06 compliance sweep).

    Background: CI builds only Server + Fits and surfaces only default-level
    analyzers, so most of the 14-project solution was never statically
    analyzed. This file is the C# analogue of "run clang-tidy across the
    whole tree": it turns on the full CAxxxx analyzer catalog and makes
    nullable-reference checking a compile-time gate everywhere.

    The whole-solution cleanup is complete: every project builds with zero CA/CS/
    SYSLIB analyzer warnings, so TreatWarningsAsErrors is now ON to keep it that way.
    Any new warning fails the build; fix it (or add a justified [SuppressMessage]).
  -->
  <PropertyGroup>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>
    <AnalysisMode>All</AnalysisMode>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- No NuGet notices are allowlisted. NU1701 (VVVV.FreeImage, a .NETFramework package)
         and NU5104 (the Accord.Math prerelease) used to be, but both dependencies are gone
         (#1386), so a NEW framework or prerelease package surfaces as an error and gets a
         conscious decision rather than slipping in silently. -->
  </PropertyGroup>

</Project>
